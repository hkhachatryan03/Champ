# Copy this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — never commit real secrets.

DATABASE_URL="your-neon-connection-string-here"
SESSION_SECRET="any-long-random-string-for-local-testing"

# A DIFFERENT long random string than SESSION_SECRET — used only to sign
# admin (BackOffice) sessions, so admin access is never protected by the
# same secret as candidate/company sessions.
ADMIN_SESSION_SECRET="any-other-long-random-string-for-local-testing"

# Only needed locally if you want to test CV uploads before deploying.
# Get this from Vercel: Project > Storage > your Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"
